<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">
    <display-name>GaraMan3</display-name>

    <servlet>
        <servlet-name>HomeController</servlet-name>
        <servlet-class>controller.HomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HomeController</servlet-name>
        <url-pattern>/home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SalesStaffHomeController</servlet-name>
        <servlet-class>controller.SalesStaffHomeController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalesStaffHomeController</servlet-name>
        <url-pattern>/sales-home</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ChangePasswordController</servlet-name>
        <servlet-class>controller.ChangePasswordController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ChangePasswordController</servlet-name>
        <url-pattern>/change-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookAppointmentController</servlet-name>
        <servlet-class>controller.BookAppointmentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookAppointmentController</servlet-name>
        <url-pattern>/book-appointment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConfirmAppointmentController</servlet-name>
        <servlet-class>controller.ConfirmAppointmentController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmAppointmentController</servlet-name>
        <url-pattern>/confirm-appointment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReceiveCarController</servlet-name>
        <servlet-class>controller.ReceiveCarController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReceiveCarController</servlet-name>
        <url-pattern>/receive-car</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ConfirmRepairOrderController</servlet-name>
        <servlet-class>controller.ConfirmRepairOrderController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ConfirmRepairOrderController</servlet-name>
        <url-pattern>/confirm-repair-order</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>
</web-app>
